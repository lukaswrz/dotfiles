#!/usr/bin/env fish

set --global systemctlflags

argparse \
    --strict-longopts \
    --name=(status filename) \
    n/now \
    -- $argv
or begin
    usage >&2
    exit 1
end

if test (count $argv) -gt 0
    echo 'too many arguments' >&2
    exit 1
end

if set --query _flag_now
    set --append systemctlflags --now
end

for file in home/*/.config/systemd/user/*
    if not test -f $file
        continue
    end

    set unit (basename -- $file)
    or exit 1

    if string match --quiet -- '*.target' $unit
        continue
    end

    systemctl $systemctlflags --user enable --verbose -- $unit
end
