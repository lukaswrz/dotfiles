// Whether new windows should go to the top or bottom of the window stack
attach_mode top

// Number of windows in the primary stack
primary_count 1

// Give the windows space to breathe
layout_margin 2
window_padding 4

// Proportion of output width taken by the primary stack
primary_ratio 0.55

// Proportion of output width taken by a window if it's the only visible tiled window
single_window_ratio 1.0

// Side the primary should be on
primary_side left

// Whether mousing over a new window should move focus
focus_follows_pointer #true

// Whether mousing over a new output should move output focus (i.e. the output new windows spawn on)
output_focus_follows_pointer #true

// Whether the focus should warp to the center of newly-focused windows
pointer_warp_on_focus_change #false

// Whether focus should be restored to the last focused visible window when switching tags or outputs
restore_focus #true

// Controls focus behavior when sending a window to another output
// Options: if_visible, never, always, always_or
focus_on_send if_visible

// Controls next window focus after a currently focused window is closed or hidden
// Options: next, prev
focus_next_direction next

cursor_theme "phinger-cursors-dark"
wallpaper_image_path "~/.wallpaper"

borders {
    width 2
    color_focused "0x31a354"
    color_unfocused "0x101010"
}

bar {
    position top
    time_format "%A, %b %d  %H:%M"
    fonts "monospace:size=12"
    text_color "0xb7b8b9"
    background_color "0x000000"
    vertical_padding 5
    horizontal_padding 20
    margins {
        top 2
        bottom 2
        left 2
        right 2
    }
}

// Tag overlay widget; shown briefly when switching tags
tag_overlay {
    tag_amount 10
    background_color "0x0c0d0e"
    border_color "0x737475"
    square_active_background_color "0x31a354"
    square_active_border_color "0x31a354"
    square_active_occupied_color "0x17c94d"
    square_inactive_background_color "0x0c0d0e"
    square_inactive_border_color "0x737475"
    square_inactive_occupied_color "0xb7b8b9"
}

// Environment variables that will be exported to each process spawned by the current beansprout instance
env {
    set SDL_VIDEODRIVER "wayland,x11"
    set QT_QPA_PLATFORM "wayland"
}

// Window rules; applied once when a window first appears
// Rules are evaluated top-to-bottom; later rules override earlier ones
window_rules {
    // Keep mpv windows tiled
    no_float app_id="mpv"
}

keybinds {
    // Programs
    spawn Mod4 Return alacritty
    spawn Mod4 D fuzzel
    spawn Mod4 B qutebrowser
    spawn Mod4 E pcmanfm-qt

    // Lock screen
    spawn Mod4+Shift V waylock

    // Move focus up or down the windows stack
    focus_next_window Mod4 J
    focus_prev_window Mod4 K

    // Move focus between windows
    focus_next_output Mod4 Period
    focus_prev_output Mod4 Comma

    // Move windows between outputs
    send_to_next_output Mod4+Shift Period
    send_to_prev_output Mod4+Shift Comma

    // Swap the currently-focused window with the current primary
    zoom Mod4 Z

    // Change the primary ratio of the current output
    change_primary_ratio Mod4 L 0.05
    change_primary_ratio Mod4 H -0.05

    // Change the number of windows in the primary side
    increment_primary_count Mod4 N
    decrement_primary_count Mod4 M

    // Reload config file
    reload_config Mod4+Shift R

    // Float/unfloat the currently-focused window
    toggle_float Mod4 Space

    // Toggle fullscreen on the currently-focused window
    toggle_fullscreen Mod4 F

    // Close the currently-focused window
    close_window Mod4+Shift Q

    // Exit the entire river session
    exit_river Ctrl+Alt Delete

    // Move windows up or down the stack
    swap_next Mod4+Shift N
    swap_prev Mod4+Shift P

    // Move floating windows; noop on tiled windows
    move_left Mod4+Shift H 100
    move_down Mod4+Shift J 100
    move_up Mod4+Shift K 100
    move_right Mod4+Shift L 100

    // Resize floating windows; noop on tiled windows
    resize_width Mod4+Alt+Shift H -100
    resize_height Mod4+Alt+Shift J 100
    resize_height Mod4+Alt+Shift K -100
    resize_width Mod4+Alt+Shift L 100

    // Media keys
    spawn None XF86AudioRaiseVolume "wolume --set 5%+" allow_locked=#true
    spawn Shift XF86AudioRaiseVolume "wolume --set 1%+" allow_locked=#true
    spawn None XF86AudioLowerVolume "wolume --set 5%-" allow_locked=#true
    spawn Shift XF86AudioLowerVolume "wolume --set 1%-" allow_locked=#true
    spawn None XF86AudioMute "wolume --mute-toggle" allow_locked=#true
    spawn None XF86AudioMedia "playerctl play-pause" allow_locked=#true
    spawn None XF86AudioPlay "playerctl play-pause" allow_locked=#true
    spawn None XF86AudioPrev "playerctl previous" allow_locked=#true
    spawn None XF86AudioNext "playerctl next" allow_locked=#true

    // Brightness keys
    spawn None XF86MonBrightnessUp "wrightness --set +5%"
    spawn Shift XF86MonBrightnessUp "wrightness --set +1%"
    spawn None XF86MonBrightnessDown "wrightness --set 5%-"
    spawn Shift XF86MonBrightnessDown "wrightness --set 1%-"

    // Toggle night light
    spawn Mod4+Shift G "wunset --toggle"

    // Special command to generate keybinds for keys 1-9 and tags 1<<0 through 1<<8
    tag_bind Mod4 set_output_tags
    tag_bind Mod4+Shift set_window_tags
    tag_bind Mod4+Ctrl toggle_output_tags
    tag_bind Mod4+Ctrl+Shift toggle_window_tags
}

pointer_binds {
    // Mod4 + Left click to move floating windows
    move_window Mod4 BTN_LEFT
    // Mod4 + Right click to resize floating windows
    resize_window Mod4 BTN_RIGHT
}

// Keyboard layout configuration
keyboard_layout {
    layout "eu"
    options "compose:rctrl"
}

// Default input config for all devices
input {
    accel_profile "flat"
    accel_speed -0.5
    natural_scroll "disabled"
    tap "disabled"
    click_method "clickfinger"
}

// TODO

// Trackpad
input name="PIXA3854:00 093A:0274 Touchpad" {
    accel_profile "adaptive"
    click_method "clickfinger"
    natural_scroll "enabled"
    tap "disabled"
}
