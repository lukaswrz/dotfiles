#!/usr/bin/env fish

if not set --query WOBSOCK
    set --global --export WOBSOCK /dev/null
end

function usage
    echo "Usage:"
    echo "  $(status filename) [OPTIONS]"
    echo
    echo "Options:"
    echo "  -h, --help  Show this help text"
    echo "  -s, --set   Adjust brightness"
end

argparse \
    --strict-longopts \
    --name=(status filename) \
    h/help \
    s/set= \
    -- $argv
or begin
    usage >&2
    exit 1
end

if set -q _flag_help
    usage
    exit
end

if set -q _flag_set
    brightnessctl set "$_flag_set" | sed -En 's/.*\(([0-9]+)%\).*/\1/p' >$WOBSOCK
end
